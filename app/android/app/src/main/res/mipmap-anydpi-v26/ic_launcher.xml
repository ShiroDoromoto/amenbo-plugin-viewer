<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher masks whatever shape it likes out of these two layers, so the tile is a plain
     colour here rather than the rounded one baked into the PNGs older Android still uses.
     The themed icon is the same strider: the system throws its colours away and keeps its
     silhouette, which is all a one-colour icon can carry anyway. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
