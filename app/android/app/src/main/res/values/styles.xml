<?xml version="1.0" encoding="utf-8"?>
<!-- One theme covers both sides of the phone's setting: what changes between them is the ground
     colour, and that is a resource which already knows about night (values-night/colors.xml).
     The parent only supplies "no title bar" — every colour that shows is named here. -->
<resources>
    <!-- Worn by the window while the process starts, and taken away by Flutter's first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Worn from then on, behind the Flutter UI. Nothing of it is normally seen; it is the
         ground colour so that the seams around a resize or a rotation are not white. -->
    <style name="NormalTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
