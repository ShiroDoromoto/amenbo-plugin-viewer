<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 stopped showing the window's background at launch and started drawing a splash of
     its own, which without these two lines is the launcher icon — tile and all — on whatever
     colour the window happens to have. Named here, it is the same sheet as everywhere else: the
     ground, and the mark alone on it.

     A style is chosen from one file, not merged across them, so the window background below is
     repeated rather than inherited from values/styles.xml.

     The icon named is `launch_mark`, which answers in white where the ground is dark — see
     drawable/launch_background.xml for why the launch sheet is not the icon's own foreground. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/launch_mark</item>
    </style>
</resources>
